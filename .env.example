# ── Языковая модель ─────────────────────────────────────────
# ollama — локальный сервер Ollama; openai — OpenAI-совместимый API
# (vLLM/TGI/Ollama /v1), например на нейрокомпьютере ЧелГУ.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Для LLM_PROVIDER=openai:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://neurocomputer.local:8000/v1
# OPENAI_API_KEY=change-me
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Таймаут запроса к модели, секунды; число повторных попыток
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1

# ── Парсер ──────────────────────────────────────────────────
# Путь к msedgedriver.exe. Если файла нет, Selenium Manager подберёт драйвер.
EDGE_DRIVER_PATH=C:/edgedriver/msedgedriver.exe
PARSER_HEADLESS=false
PARSER_PAGE_TIMEOUT=60
MAIN_URL=https://sudact.ru/practice/sudebnaya-praktika-po-grazhdanskim-delam/

# ── Данные и индексы ────────────────────────────────────────
# PARSED_TEXTS_DIR=parsed_texts
# PARSED_URLS_FILE=parsed_urls.json
# INDEX_FILE=document_index.faiss
# CHUNKS_DATA_FILE=chunks_data.pkl
# BM25_FILE=bm25_index.pkl
# QUERY_LOGS_DB=query_logs.db

# ── Поиск ───────────────────────────────────────────────────
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# DEFAULT_TOP_K=5
# RRF_K=60

# ── Планировщик ─────────────────────────────────────────────
COLLECTION_INTERVAL_HOURS=24
# Запускать сбор и индексацию сразу при старте сервера
RUN_PIPELINE_ON_START=false

# ── Веб-сервер ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
# Для нескольких источников перечислите их через запятую
CORS_ORIGINS=http://localhost:8000
